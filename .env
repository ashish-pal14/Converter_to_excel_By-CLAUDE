# Copy to .env and adjust.
MAX_FILE_MB=50
MAX_PAGES=300
# parallel conversions (default: CPU cores - 1)
WORKERS=3
# minutes before uploads and results are deleted
JOB_TTL_MINUTES=60
# default OCR language(s), must be installed (see Dockerfile OCR_LANGS)
OCR_LANG=eng
# set to require an X-API-Key header on every API call (leave empty for none)
API_KEY=
# comma-separated origins allowed to call the API from other websites
CORS_ORIGINS=
